# Copiá este archivo según el entorno:
#   cp .env.example .env.development   (npm run dev)
#   cp .env.example .env.production    (vite build / Vercel)
#   cp .env.example .env.capacitor     (build Android)
#
# No subas archivos .env* reales al repositorio.
# En Vercel: Settings → Environment Variables (mismas claves).

# URL base de la API (incluye /api)
VITE_API_URL=http://localhost:5029/api

# Hub SignalR de tiempos
VITE_SIGNALR_HUB_URL=http://localhost:5029/hubs/timing

# URL pública de la app (producción)
VITE_PUBLIC_APP_URL=http://localhost:5173

# Solo desarrollo: destino del proxy de Vite (opcional)
# VITE_API_TARGET=https://sporttrack-sigdef.onrender.com
